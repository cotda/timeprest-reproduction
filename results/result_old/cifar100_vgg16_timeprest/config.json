  "training": {
    "epochs": 160,
    "batch_size": 192,
    "optimizer": "sgd",
    "lr": 0.05,
    "momentum": 0.9,
    "nesterov": false,
    "weight_decay": 0.0005,
    "lr_schedule": "cosine",
    "warmup_epochs": 5,
    "drop_last": true
  },
  "runtime": {
    "device": "cuda",
    "deterministic": false,
    "profile_ops": true,
    "eval_batch_size": 500,
    "comm_bandwidth_gbps": 10.0,
    "comm_latency_ms": 0.05
  },
  "output": {
    "dir": "/content/drive/MyDrive/timeprest/runs/cifar100_vgg16_timeprest",
    "require_checks": true,
    "checks_file": "results/checks/latest.json"
  },
  "checks": {}
