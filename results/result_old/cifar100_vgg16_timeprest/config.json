{
  "name": "cifar100_vgg16_timeprest",
  "seed": 0,
  "system": "timeprest",
  "data": {
    "dataset": "cifar100",
    "root": "/content/drive/MyDrive/datasets",
    "train_subset": null,
    "test_subset": null,
    "augment": true,
    "num_workers": 2,
    "download": false
  },
  "model": {
    "name": "vgg16_bn_cifar",
    "num_classes": 100,
    "width": 1.0
  },
  "pipeline": {
    "num_stages": 2,
    "num_microbatches": 3,
    "partition": "auto",
